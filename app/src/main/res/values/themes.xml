<resources>
    <!-- Splash screen (Android 12+ system splash; backported by core-splashscreen) -->
    <style name="Theme.AgriSupport.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/forest_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.AgriSupport</item>
    </style>

    <style name="Theme.AgriSupport" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/forest_dark</item>
        <item name="android:statusBarColor">@color/forest_dark</item>
        <item name="android:navigationBarColor">@color/forest_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
